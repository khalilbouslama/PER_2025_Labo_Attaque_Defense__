<group name="local,attack_detection,">

<!-- ================================================= -->
<!-- SCENARIO EASY : APACHE (target-apache / gateway)  -->
<!-- ================================================= -->

<rule id="100060" level="12">
  <if_sid>31108</if_sid>
  <regex>GET\s+/backup_key\.pem</regex>
  <description>CRITICAL(EASY): Apache - SSH private key accessed (backup_key.pem)</description>
  <mitre><id>T1552.004</id></mitre>
  <group>data_exfiltration,apache,easy,</group>
</rule>

<rule id="100062" level="12">
  <if_sid>5715</if_sid>
  <match>webuser</match>
  <description>CRITICAL(EASY): SSH webuser login successful (stolen key)</description>
  <mitre><id>T1078.004</id></mitre>
  <group>authentication_success,ssh,apache,easy,</group>
</rule>

<rule id="100063" level="15">
  <if_group>syscheck</if_group>
  <match>/usr/bin/bash</match>
  <description>CRITICAL(EASY): Apache - /usr/bin/bash modified (SUID backdoor)</description>
  <mitre><id>T1548.001</id></mitre>
  <group>file_integrity,privilege_escalation,apache,easy,</group>
</rule>

<rule id="100064" level="15">
  <match>/usr/bin/bash -p</match>
  <description>CRITICAL(EASY): Privilege escalation via SUID bash executed</description>
  <mitre><id>T1548.001</id></mitre>
  <group>privilege_escalation,apache,easy,</group>
</rule>

<rule id="100066" level="10" frequency="3" timeframe="60">
  <if_matched_sid>100060</if_matched_sid>
  <same_source_ip />
  <description>CRITICAL(EASY): Apache - Repeated access to SSH private key</description>
  <mitre><id>T1552.004</id><id>T1046</id></mitre>
  <group>reconnaissance,apache,easy,</group>
</rule>

<rule id="100067" level="13" frequency="10" timeframe="60">
  <if_matched_sid>100060</if_matched_sid>
  <description>CRITICAL(EASY): Apache - Mass automated access to SSH key</description>
  <mitre><id>T1552.004</id><id>T1046</id></mitre>
  <group>reconnaissance,apache,easy,</group>
</rule>

<!-- ================================================= -->
<!-- SCENARIO MEDIUM : WEB GATEWAY (upload + RCE)      -->
<!-- ================================================= -->

<!-- Upload endpoint hit -->
<rule id="100100" level="8">
  <if_sid>31108</if_sid>
  <regex>POST\s+/upload\.php</regex>
  <description>TARGET-WEB(MEDIUM): File upload attempt detected (upload.php)</description>
  <mitre><id>T1105</id></mitre>
  <group>web,file_upload,target_web,medium,</group>
</rule>

<!-- Upload suspect via tools -->
<rule id="100101" level="10">
  <if_sid>100100</if_sid>
  <regex>curl/|python-requests|wget/|multipart/form-data</regex>
  <description>TARGET-WEB(MEDIUM): Suspicious automated upload attempt (tool-based)</description>
  <mitre><id>T1105</id></mitre>
  <group>web,file_upload,reconnaissance,target_web,medium,</group>
</rule>

<!-- Webshell/RCE usage -->
<rule id="100110" level="12">
  <if_sid>31108</if_sid>
  <regex>GET\s+/uploads/payload\.php\?cmd=</regex>
  <description>CRITICAL(MEDIUM): Webshell/RCE execution via /uploads/payload.php?cmd=</description>
  <mitre><id>T1059</id></mitre>
  <group>webshell,execution,target_web,critical,medium,</group>
</rule>

<!-- Detect LD_PRELOAD in URL (encoded or not) -->
<rule id="100111" level="13">
  <if_sid>31108</if_sid>
  <regex>LD_PRELOAD|LD_PRELOAD%3D|LD_PRELOAD=</regex>
  <description>CRITICAL(MEDIUM): LD_PRELOAD observed in web traffic (possible privesc)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>privilege_escalation,defense_evasion,target_web,critical,medium,</group>
</rule>

<!-- gcc -fPIC compilation (handles + / %20 / space) -->
<rule id="100103" level="10">
  <if_sid>31108</if_sid>
  <regex>gcc(\+|%20|\s)+-fPIC(\+|%20|\s)+-shared(\+|%20|\s)+-o</regex>
  <description>MEDIUM: Shared library compilation detected (gcc -fPIC -shared -o)</description>
  <mitre><id>T1027</id></mitre>
  <group>compilation,privilege_escalation_prep,target_web,medium,</group>
</rule>

<!-- suspicious .so path (encoded or not) -->
<rule id="100104" level="12">
  <if_sid>31108</if_sid>
  <regex>/tmp/shell\.so|/tmp/exploit\.so|/var/tmp/shell\.so|%2ftmp%2fshell\.so|%2fvar%2ftmp%2fshell\.so</regex>
  <description>CRITICAL(MEDIUM): Suspicious .so path in web traffic (LD_PRELOAD prep)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>privilege_escalation,defense_evasion,target_web,critical,medium,</group>
</rule>

<!-- Pivot SSH root login -->
<rule id="100109" level="12">
  <if_sid>5715</if_sid>
  <regex>Accepted password for root from 172\.25\.</regex>
  <description>MEDIUM: SSH root login detected (possible pivot)</description>
  <mitre><id>T1021.004</id></mitre>
  <group>lateral_movement,ssh,target_web,medium,</group>
</rule>

<!-- sudo gzip executed (LD_PRELOAD privesc) -->
<rule id="100105" level="15">
  <if_group>sudo</if_group>
  <regex>COMMAND=/usr/bin/gzip|COMMAND=/bin/gzip|sudo:.*gzip</regex>
  <description>CRITICAL(MEDIUM): sudo gzip executed (possible LD_PRELOAD privilege escalation)</description>
  <mitre><id>T1574.006</id><id>T1548.003</id></mitre>
  <group>privilege_escalation,sudo_abuse,target_web,critical,medium,</group>
</rule>

<!-- www-data sudo gzip -->
<rule id="100106" level="15">
  <if_group>sudo</if_group>
  <regex>www-data.*COMMAND=/usr/bin/gzip|www-data.*gzip</regex>
  <description>CRITICAL(MEDIUM): www-data executed sudo gzip (high confidence privesc)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>privilege_escalation,sudo_abuse,target_web,critical,medium,</group>
</rule>

</group>

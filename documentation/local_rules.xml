<group name="local,attack_detection,">

<!-- ============================================= -->
<!-- SCÉNARIO 1 : FTP (target-ftp)                -->
<!-- ============================================= -->
<rule id="100011" level="6">
  <if_sid>11402</if_sid>
  <regex>anon password</regex>
  <description>FTP: Anonymous login detected (vsftpd)</description>
  <mitre><id>T1078.001</id></mitre>
  <group>authentication_success,ftp,</group>
</rule>

<rule id="100020" level="7">
  <decoded_as>vsftpd</decoded_as>
  <regex>OK DOWNLOAD:</regex>
  <description>FTP: File download detected (vsftpd)</description>
  <mitre><id>T1213</id></mitre>
  <group>access,ftp,</group>
</rule>

<rule id="100021" level="12">
  <if_sid>100020</if_sid>
  <regex>"/pub/flag\.txt"</regex>
  <description>FTP: CRITICAL - FLAG file downloaded</description>
  <mitre><id>T1213</id><id>T1041</id></mitre>
  <group>data_exfiltration,ftp,</group>
</rule>

<!-- ============================================= -->
<!-- SCÉNARIO 2 : SAMBA/SSH (target-samba)        -->
<!-- ============================================= -->
<rule id="100030" level="5">
  <regex>Allowed connection from|connect to service public</regex>
  <description>SMB: Client connection detected</description>
  <mitre><id>T1021.002</id></mitre>
  <group>samba,authentication_success,</group>
</rule>

<rule id="100032" level="6">
  <regex>opened file|smbd_smb2_read</regex>
  <description>SMB: File operation detected (open/read)</description>
  <mitre><id>T1039</id></mitre>
  <group>samba,data_access,</group>
</rule>

<rule id="100033" level="10">
  <if_sid>100032</if_sid>
  <regex>note_service\.txt|flag\.txt|credentials|password|\.ssh|\.key</regex>
  <description>SMB: CRITICAL - Sensitive file accessed</description>
  <mitre><id>T1039</id><id>T1213</id></mitre>
  <group>samba,data_exfiltration,</group>
</rule>

<rule id="100034" level="8" frequency="5" timeframe="120">
  <if_matched_sid>100030</if_matched_sid>
  <description>SMB: Multiple connections detected (possible enumeration)</description>
  <mitre><id>T1083</id></mitre>
  <group>reconnaissance,smb,</group>
</rule>

<rule id="100038" level="5">
  <if_sid>5710</if_sid>
  <description>SSH: Failed authentication attempt (non-existent user)</description>
  <mitre><id>T1110.001</id></mitre>
  <group>authentication_failed,ssh,</group>
  <options>no_log</options>
</rule>

<rule id="100037" level="12" frequency="5" timeframe="120">
  <if_matched_sid>100038</if_matched_sid>
  <same_source_ip />
  <description>SSH: Brute force attack detected (5+ attempts)</description>
  <mitre><id>T1110.001</id></mitre>
  <group>authentication_failed,ssh,brute_force,</group>
</rule>

<rule id="100036" level="12">
  <if_sid>5715</if_sid>
  <match>sambauser</match>
  <description>CRITICAL: SSH sambauser login successful</description>
  <mitre><id>T1078</id></mitre>
  <group>authentication_success,ssh,</group>
</rule>

<!-- ============================================= -->
<!-- PRIVILEGE ESCALATION (Samba)                 -->
<!-- ============================================= -->
<rule id="100039" level="12">
  <if_sid>5501</if_sid>
  <match>by sambauser(uid=0)</match>
  <description>CRITICAL: Suspicious session - sambauser opened session with uid=0</description>
  <mitre><id>T1548.001</id></mitre>
  <group>privilege_escalation,suid_abuse,</group>
</rule>

<rule id="100040" level="8">
  <match>find / -perm</match>
  <description>Privilege Escalation: SUID file enumeration</description>
  <mitre><id>T1548.001</id></mitre>
  <group>reconnaissance,privilege_escalation,</group>
</rule>

<rule id="100041" level="15">
  <match>find . -exec /bin/sh -p</match>
  <description>CRITICAL: Privilege escalation via find -exec</description>
  <mitre><id>T1548.001</id></mitre>
  <group>privilege_escalation,</group>
</rule>

<!-- ============================================= -->
<!-- SCÉNARIO 3 : JENKINS (target-jenkins)        -->
<!-- ============================================= -->
<rule id="100050" level="10">
  <match>script /dev/null</match>
  <description>Jenkins: Shell stabilization detected (script command)</description>
  <mitre><id>T1059.004</id></mitre>
  <group>execution,jenkins,post_exploit,</group>
</rule>

<rule id="100051" level="8">
  <match>sudo vim -c</match>
  <description>Jenkins: Sudo vim with command execution detected</description>
  <mitre><id>T1548.001</id></mitre>
  <group>reconnaissance,jenkins,privilege_escalation,</group>
</rule>

<rule id="100052" level="12">
  <if_sid>5400</if_sid>
  <match>vim</match>
  <description>CRITICAL: Jenkins sudo vim exploitation detected</description>
  <mitre><id>T1548.001</id></mitre>
  <group>privilege_escalation,jenkins,</group>
</rule>

<rule id="100053" level="15">
  <if_sid>5501</if_sid>
  <regex>by \(uid=1000\)</regex>
  <description>CRITICAL: Jenkins user escalated to root</description>
  <mitre><id>T1548</id></mitre>
  <group>privilege_escalation,jenkins,</group>
</rule>

<!-- ============================================= -->
<!-- SCÉNARIO 4 : APACHE (target-apache)          -->
<!-- ============================================= -->
<rule id="100060" level="12">
  <if_sid>31108</if_sid>
  <regex>GET\s+/backup_key\.pem</regex>
  <description>CRITICAL: Apache - SSH private key accessed (backup_key.pem)</description>
  <mitre><id>T1552.004</id></mitre>
  <group>data_exfiltration,web,apache,credential_theft,</group>
</rule>

<rule id="100066" level="10" frequency="3" timeframe="60">
  <if_matched_sid>100060</if_matched_sid>
  <same_source_ip />
  <description>CRITICAL: Apache - Repeated access to SSH private key (automated abuse / pivot prep)</description>
  <mitre><id>T1552.004</id><id>T1046</id></mitre>
  <group>credential_theft,apache,post_exploit,reconnaissance,</group>
</rule>

<rule id="100067" level="13" frequency="10" timeframe="60">
  <if_matched_sid>100060</if_matched_sid>
  <description>CRITICAL: Apache - Mass automated access to SSH key (scanning/exfiltration)</description>
  <mitre><id>T1552.004</id><id>T1046</id></mitre>
  <group>credential_theft,apache,automation,</group>
</rule>

<rule id="100062" level="12">
  <if_sid>5715</if_sid>
  <match>webuser</match>
  <description>CRITICAL: SSH webuser login successful (stolen key)</description>
  <mitre><id>T1078.004</id></mitre>
  <group>authentication_success,ssh,apache,credential_theft,</group>
</rule>

<rule id="100063" level="15">
  <if_group>syscheck</if_group>
  <match>/usr/bin/bash</match>
  <description>CRITICAL: Apache - /usr/bin/bash modified (SUID backdoor via cron)</description>
  <mitre><id>T1548.001</id></mitre>
  <group>privilege_escalation,apache,suid_abuse,</group>
</rule>

<rule id="100064" level="15">
  <match>/usr/bin/bash -p</match>
  <description>CRITICAL: Privilege escalation via SUID bash executed</description>
  <mitre><id>T1548.001</id></mitre>
  <group>privilege_escalation,apache,suid_abuse,</group>
</rule>

</group>

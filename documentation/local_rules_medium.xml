<!-- 100104: Traces .so suspect -->
<rule id="100104" level="12">
  <decoded_as>bash_cmd</decoded_as>
  <regex>/tmp/shell\.so|/tmp/exploit\.so|/var/tmp/shell\.so</regex>
  <description>CRITICAL: Suspicious shared library path (possible LD_PRELOAD prep)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>privilege_escalation,defense_evasion,target_web,critical,medium,</group>
</rule>

<!-- 100107: FIM shell.so -->
<rule id="100107" level="10">
  <if_group>syscheck</if_group>
  <match>/tmp/shell\.so|/tmp/exploit\.so</match>
  <description>TARGET-WEB: Malicious shared library detected in /tmp (FIM)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>file_integrity,privilege_escalation_prep,target_web,medium,</group>
</rule>

<!-- 100105: sudo gzip (LD_PRELOAD) -->
<rule id="100105" level="15">
  <if_group>sudo</if_group>
  <regex>COMMAND=/usr/bin/gzip|COMMAND=/bin/gzip|sudo:.*gzip</regex>
  <description>CRITICAL: TARGET-WEB: sudo gzip executed (possible LD_PRELOAD privilege escalation)</description>
  <mitre><id>T1574.006</id><id>T1548.003</id></mitre>
  <group>privilege_escalation,sudo_abuse,target_web,critical,medium,</group>
</rule>

<!-- 100106: www-data sudo gzip -->
<rule id="100106" level="15">
  <if_group>sudo</if_group>
  <regex>www-data.*COMMAND=/usr/bin/gzip|www-data.*gzip</regex>
  <description>CRITICAL: TARGET-WEB: www-data executed sudo gzip (high confidence privesc)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>privilege_escalation,sudo_abuse,target_web,critical,medium,</group>
</rule>

</group>

<group name="local,medium_scenario,">

<!-- ============================================= -->
<!-- MEDIUM - TARGET-WEB (172.25.0.40)            -->
<!-- Gateway / LD_PRELOAD / SSH Tunnel            -->
<!-- ============================================= -->

<!-- 100100: Upload fichier PHP malveillant -->
<rule id="100100" level="8">
  <if_sid>31108</if_sid>
  <regex>POST /upload\.php</regex>
  <description>TARGET-WEB: File upload attempt detected (upload.php)</description>
  <mitre><id>T1105</id></mitre>
  <group>web,file_upload,target_web,</group>
</rule>

<!-- 100101: Upload de shell.php spécifiquement -->
<rule id="100101" level="12">
  <if_sid>100100</if_sid>
  <regex>shell\.php|webshell|cmd\.php|backdoor\.php|rev\.php</regex>
  <description>CRITICAL: Malicious PHP file uploaded (potential webshell)</description>
  <mitre><id>T1505.003</id></mitre>
  <group>web,webshell,file_upload,target_web,</group>
</rule>

<!-- 100102: Accès au webshell uploadé -->
<rule id="100102" level="10">
  <if_sid>31108</if_sid>
  <regex>GET /uploads/shell\.php|GET /uploads/.*\.php</regex>
  <description>TARGET-WEB: Webshell execution attempt detected</description>
  <mitre><id>T1059.004</id></mitre>
  <group>web,webshell,execution,target_web,</group>
</rule>

<!-- 100103: Compilation gcc (préparation exploit LD_PRELOAD) -->
<rule id="100103" level="8">
  <match>gcc -fPIC -shared -o</match>
  <description>TARGET-WEB: Compilation of shared library detected (gcc -fPIC)</description>
  <mitre><id>T1027</id></mitre>
  <group>compilation,privilege_escalation_prep,target_web,</group>
</rule>


<!-- 100104: Détection alternative LD_PRELOAD via /tmp/shell.so -->
<rule id="100104" level="12">
  <match>/tmp/shell.so|/tmp/exploit.so|/var/tmp/shell.so</match>
  <description>CRITICAL: Suspicious shared library in /tmp (LD_PRELOAD preparation)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>privilege_escalation,sudo_abuse,target_web,</group>
</rule>

<!-- 100107: Détection via syscheck (FIM) si le fichier .so est créé -->
<rule id="100107" level="10">
  <if_group>syscheck</if_group>
  <match>/tmp/shell.so|/tmp/exploit.so</match>
  <description>TARGET-WEB: Malicious shared library detected in /tmp (FIM)</description>
  <mitre><id>T1574.006</id></mitre>
  <group>file_integrity,privilege_escalation_prep,target_web,</group>
</rule>

<!-- 100105: Escalade root réussie (www-data → root) -->
<rule id="100105" level="15">
  <if_sid>5501</if_sid>
  <regex>by www-data.*uid=0</regex>
  <description>CRITICAL: www-data escalated to root (LD_PRELOAD exploit successful)</description>
  <mitre><id>T1548</id></mitre>
  <group>privilege_escalation,target_web,</group>
</rule>

<!-- 100106: Tunnel SSH dynamique (pivot) -->
<rule id="100106" level="12">
  <match>ssh -N -D</match>
  <description>CRITICAL: SSH dynamic tunnel created (pivot preparation)</description>
  <mitre><id>T1090.001</id></mitre>
  <group>lateral_movement,ssh_tunnel,target_web,</group>
</rule>

</group>

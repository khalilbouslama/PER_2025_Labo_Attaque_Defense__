<!-- Local rules - Easy Scenario -->

<!-- FTP: Detection acces anonyme et exfiltration -->
<group name="local,easy_scenario,attack_detection">

  <rule id="100011" level="6">
    <if_sid>11402</if_sid>
    <match>anon password</match>
    <description>FTP: Anonymous login detected (vsftpd)</description>
    <mitre><id>T1078.001</id></mitre>
  </rule>

  <rule id="100020" level="7">
    <decoded_as>vsftpd</decoded_as>
    <match>OK DOWNLOAD:</match>
    <description>FTP: File download detected (vsftpd)</description>
    <mitre><id>T1213</id></mitre>
  </rule>

  <rule id="100021" level="12">
    <if_sid>100020</if_sid>
    <match>flag.txt</match>
    <description>FTP: CRITICAL - FLAG file downloaded</description>
    <mitre><id>T1213</id><id>T1041</id></mitre>
  </rule>


<!-- SMB: Detection connexion et acces fichiers sensibles -->

  <rule id="100030" level="5">
    <match>Allowed connection from</match>
    <description>SMB: Client connection detected</description>
    <mitre><id>T1021.002</id></mitre>
  </rule>

  <rule id="100032" level="6">
    <match>opened file</match>
    <description>SMB: File open operation detected</description>
    <mitre><id>T1039</id></mitre>
  </rule>

  <rule id="100033" level="10">
    <if_sid>100032</if_sid>
    <match>note_service.txt</match>
    <description>SMB: CRITICAL - Sensitive file accessed (credentials leak)</description>
    <mitre><id>T1039</id><id>T1213</id></mitre>
  </rule>

  <rule id="100034" level="8" frequency="5" timeframe="120">
    <if_matched_sid>100030</if_matched_sid>
    <description>SMB: Multiple connections detected (possible enumeration)</description>
    <mitre><id>T1083</id></mitre>
  </rule>


<!-- SSH: Brute force -->
<!-- AR configuree sur regle native 5763 (8 tentatives / 120s) -->

  <rule id="100036" level="12">
    <if_sid>5715</if_sid>
    <match>sambauser</match>
    <description>CRITICAL: SSH sambauser login successful</description>
    <mitre><id>T1078</id></mitre>
  </rule>


<!-- Escalade de privileges: sudo vim -->
<!-- NOTE: On detecte l intention (sudo vim par compte de service) -->
<!-- mais PAS l escape reelle (:!/bin/bash dans vim = invisible au SIEM) -->

  <rule id="100052" level="12">
    <if_sid>5402</if_sid>
    <match>COMMAND=/usr/bin/vim</match>
    <description>CRITICAL: Sudo vim exploitation detected - escalation to root</description>
    <mitre><id>T1548.001</id></mitre>
  </rule>

  <rule id="100073" level="12">
    <if_sid>5403</if_sid>
    <match>COMMAND=/usr/bin/vim</match>
    <description>CRITICAL: First time sudo vim exploitation detected</description>
    <mitre><id>T1548.001</id></mitre>
  </rule>

  <rule id="100053" level="15">
    <if_sid>5501</if_sid>
    <match>session opened for user root</match>
    <description>CRITICAL: Non-root user escalated to root via sudo</description>
    <mitre><id>T1548</id></mitre>
  </rule>


<!-- SSH login compromis -->

  <rule id="100070" level="12">
    <if_sid>5715</if_sid>
    <match>ftpuser</match>
    <description>CRITICAL: SSH ftpuser login successful (compromised account)</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="100062" level="12">
    <if_sid>5715</if_sid>
    <match>webuser</match>
    <description>CRITICAL: SSH webuser login successful (stolen key)</description>
    <mitre><id>T1078.004</id></mitre>
  </rule>


<!-- Apache: Detection vol de cle SSH -->

  <rule id="100060" level="12">
    <if_sid>31108</if_sid>
    <url>/backup_key.pem</url>
    <description>CRITICAL: Apache - SSH private key accessed (backup_key.pem)</description>
    <mitre><id>T1552.004</id></mitre>
  </rule>

  <rule id="100063" level="15">
    <if_group>syscheck</if_group>
    <match>/usr/bin/bash</match>
    <description>CRITICAL: Apache - /usr/bin/bash modified (SUID backdoor via cron)</description>
    <mitre><id>T1548.001</id></mitre>
  </rule>

  <rule id="100066" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100060</if_matched_sid>
    <same_source_ip />
    <description>CRITICAL: Apache - Repeated access to SSH private key</description>
    <mitre><id>T1552.004</id><id>T1046</id></mitre>
  </rule>

</group>
